    "safe:once": "node src/safe-auto-confirm-deposit.js --config config/safe-wallets.json --once",
    "safe:watch": "node src/safe-auto-confirm-deposit.js --config config/safe-wallets.json --watch",
    "safe:dry-run": "node src/safe-auto-confirm-deposit.js --config config/safe-wallets.json --once --dry-run",
    "safe:refresh": "node src/safe-auto-confirm-deposit.js --config config/safe-wallets.json --refresh-only"
